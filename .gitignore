.DS_Store

# Local-only working material, never published: plans, specs, ADRs,
# session settings and anything else Claude Code keeps under .claude/.
# Only the contributor guide is tracked (a root CLAUDE.md is flagged by the directory validator).
.claude/*
!.claude/CLAUDE.md
plans/
specs/
docs/plans/
docs/specs/

# Local tooling state and secrets
.grepai/
.env
.env.*
!.env.example
*.local.*

# Auto-generated bench output (named results/<date>.md); curated reports kept by hand
benchmarks/results/2[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
